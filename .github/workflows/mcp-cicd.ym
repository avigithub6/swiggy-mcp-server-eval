name: Swiggy MCP Evaluation & Conditional CD

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  # JOB 1: CI Quality Gate (50-Question MCP Benchmark)
  evaluate-mcp:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python 3.13
        uses: actions/setup-python@v5
        with:
          python-version: '3.13'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run 50-Question MCP Evaluation Benchmark
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
        run: |
          echo "Evaluation crashed before generating report. Check GitHub Actions logs." > eval_report.txt
          python evals/evaluate.py

      - name: Upload Evaluation Metrics Artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: mcp-eval-report
          path: |
            eval_report.txt
            eval_metrics.json

      # Email Developer ONLY if Quality Gate Fails (< 80% Accuracy)
      - name: Send Failure Diagnostic Email
        if: failure()
        uses: dawidd6/action-send-mail@v3
        with:
                    server_address: smtp.gmail.com
          server_port: 465
          username: ${{ secrets.MAIL_USERNAME }}
          password: ${{ secrets.MAIL_PASSWORD }}
          subject: "🚨 Swiggy MCP Build Failed: Quality Gate or Runtime Error"
          to: ${{ secrets.DEV_ALERT_EMAIL }}
          from: "MCP CI/CD Quality Gate"
          body: file://eval_report.txt

      # Email Developer when Quality Gate Passes
      - name: Send Pass Confirmation Email
        if: success()
        uses: dawidd6/action-send-mail@v3
        with:
                    server_address: smtp.gmail.com
          server_port: 465
          username: ${{ secrets.MAIL_USERNAME }}
          password: ${{ secrets.MAIL_PASSWORD }}
          subject: "✅ Swiggy MCP Quality Gate Passed (92%+): Triggering CD"
          to: ${{ secrets.DEV_ALERT_EMAIL }}
          from: "MCP CI/CD Quality Gate"
          body: file://eval_report.txt

  # JOB 2: CD (Triggers ONLY when evaluate-mcp passes)
  deploy-mcp:
    needs: evaluate-mcp
    if: success() && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - name: Deploy Verified MCP Server
        run: |
          echo "✅ Quality gate passed! Deploying Swiggy MCP Server..."
